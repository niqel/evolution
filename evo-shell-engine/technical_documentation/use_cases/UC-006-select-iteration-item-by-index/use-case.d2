direction: down

use_case: "Index\nSeleccionar un elemento por índice" {
  shape: rectangle
}

input: "StructuredItems<'a>\nusize" {
  shape: rectangle
}

output: "StructuredItems<'a>\n1 elemento" {
  shape: rectangle
}

error: "IndexError" {
  shape: rectangle
  style.fill: "#fff0f0"
}

use_case -> input: "entrada"
input -> output: "si encuentra exactamente uno"
input -> error: "si no encuentra o es ambiguo"
