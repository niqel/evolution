direction: down

consumer: "Consumidor externo\n\nevo-shell / evo-script / otro componente" {
  shape: rectangle
}

use_case: "ToArgs(StructuredProjection)" {
  shape: rectangle
}

agent: "argument_expander::expand" {
  shape: rectangle
}

resolver: "to_args::resolve" {
  shape: rectangle
}

projection: "StructuredProjection\n0..N filas / 1 propiedad" {
  shape: rectangle
}

arguments: "Arguments\ncolección tipada de ProjectedValue" {
  shape: rectangle
}

error: "ToArgsError\ncardinalidad inválida" {
  shape: rectangle
  style.fill: "#fff0f0"
}

consumer -> use_case: "invoca"
use_case -> agent: "implementado por"
projection -> use_case: "entrada prestada"
agent -> resolver: "coordina"
resolver -> arguments: "expande valores preservando orden"
resolver -> error: "si la cardinalidad no cumple"
arguments -> consumer: "éxito"

note: "No provider.\nNo parser textual.\nNo filesystem IO.\nNo terminal IO." {
  shape: rectangle
  style.fill: "#fff7e6"
}

resolver -> note
