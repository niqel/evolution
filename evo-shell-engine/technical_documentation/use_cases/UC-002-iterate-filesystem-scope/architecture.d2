direction: down

definitions: "definitions" {
  style.fill: "#edf4ff"

  iter_use_case: "Use case público\n\ndefinitions/use_cases/iter.rs\nIter(&FilesystemScope)" {
    shape: rectangle
  }

  advance_use_case: "Use case público\n\ndefinitions/use_cases/advance.rs\nAdvance(&mut FilesystemIteration)\n\nconceptualmente devuelve\nOption<FilesystemIterationItem>" {
    shape: rectangle
  }

  read_directory_contract: "Contract interno\n\ndefinitions/contracts/read_directory.rs\nReadDirectory" {
    shape: rectangle
  }

  next_directory_entry_contract: "Contract interno\n\ndefinitions/contracts/next_directory_entry.rs\nNextDirectoryEntry" {
    shape: rectangle
  }

  filesystem_iteration_entity: "Domain entity\n\ndefinitions/domain/entities/filesystem_iteration.rs\nFilesystemIteration\n\nposee estado lazy\nread_dir state\nnext_index\nno contiene Vec" {
    shape: rectangle
  }

  filesystem_iteration_item_entity: "Domain entity\n\nFilesystemIterationItem\n\nindex\nentry: FilesystemEntry" {
    shape: rectangle
  }

  filesystem_entry_entity: "Domain entity\n\ndefinitions/domain/entities/filesystem_entry.rs\nFilesystemEntry\n\nname\npath\nkind\nmodified\nsize\n\nsin index" {
    shape: rectangle
  }
}

agents: "agents" {
  style.fill: "#eefaf1"

  iterator: "Agent\n\nagents/iterator.rs\niterator::iter" {
    shape: rectangle
  }

  iteration_advancer: "Agent\n\nagents/iteration_advancer.rs\niteration_advancer::advance\n\nempaqueta index + entry" {
    shape: rectangle
  }
}

resolvers: "resolvers" {
  style.fill: "#fff7e6"

  filesystem_iteration: "Resolver\n\nresolvers/filesystem_iteration.rs\nfilesystem_iteration::resolve\n\ninicia la iteración\ninicializa next_index en 0\nno enumera todo" {
    shape: rectangle
  }

  filesystem_entry: "Resolver existente\n\nresolvers/filesystem_entry.rs\nfilesystem_entry::resolve\n\nmaterializa FilesystemEntry\ncon tipo y metadata" {
    shape: rectangle
  }
}

providers: "providers" {
  style.fill: "#f7edff"

  read_directory_provider: "Provider interno\n\nproviders/read_directory.rs\nread_directory::provide" {
    shape: rectangle
  }

  next_directory_entry_provider: "Provider interno\n\nproviders/next_directory_entry.rs\nnext_directory_entry::provide" {
    shape: rectangle
  }
}

infrastructure: "infrastructure" {
  style.fill: "#f2f2f2"

  read_dir: "std::fs::read_dir" {
    shape: rectangle
  }

  read_dir_state: "std::fs::ReadDir" {
    shape: rectangle
  }

  read_dir_next: "ReadDir::next" {
    shape: rectangle
  }

  dir_entry: "std::fs::DirEntry / fin / error\n\nfile_type\nmetadata cuando aplique" {
    shape: rectangle
  }
}

scope: "FilesystemScope válido\nrecibido como &FilesystemScope\ninvariante establecida por UC-001" {
  shape: rectangle
}

consumer: "consumidor externo\n\nevo-shell / evo-script / otro componente" {
  shape: rectangle
}

consumer -> definitions.iter_use_case: "frontera pública"
definitions.iter_use_case -> agents.iterator: "implementado por"
scope -> agents.iterator: "entrada prestada"
agents.iterator -> resolvers.filesystem_iteration: "coordina inicio usando provider interno"
resolvers.filesystem_iteration -> definitions.read_directory_contract: "consume"
definitions.read_directory_contract -> providers.read_directory_provider: "implementado por"
providers.read_directory_provider -> infrastructure.read_dir: "usa"
infrastructure.read_dir -> infrastructure.read_dir_state: "devuelve"
resolvers.filesystem_iteration -> definitions.filesystem_iteration_entity: "crea/devuelve"
definitions.filesystem_iteration_entity -> infrastructure.read_dir_state: "posee estado de infraestructura"
definitions.filesystem_iteration_entity -> consumer: "FilesystemIteration"

consumer -> definitions.advance_use_case: "frontera pública"
definitions.advance_use_case -> agents.iteration_advancer: "implementado por"
agents.iteration_advancer -> resolvers.filesystem_entry: "coordina resolución de entry"
resolvers.filesystem_entry -> definitions.next_directory_entry_contract: "consume"
definitions.next_directory_entry_contract -> providers.next_directory_entry_provider: "implementado por"
providers.next_directory_entry_provider -> definitions.filesystem_iteration_entity: "recibe &mut FilesystemIteration"
definitions.filesystem_iteration_entity -> infrastructure.read_dir_state: "mutabilidad localizada del cursor"
providers.next_directory_entry_provider -> infrastructure.read_dir_next: "usa"
infrastructure.read_dir_next -> infrastructure.dir_entry: "DirEntry / fin / error"
infrastructure.dir_entry -> resolvers.filesystem_entry: "resultado de infraestructura"
resolvers.filesystem_entry -> definitions.filesystem_entry_entity: "FilesystemEntry / None / IterError"
definitions.filesystem_iteration_entity -> agents.iteration_advancer: "next_index"
agents.iteration_advancer -> definitions.filesystem_iteration_item_entity: "index + entry"
definitions.filesystem_entry_entity -> definitions.filesystem_iteration_item_entity: "entry"
definitions.filesystem_iteration_item_entity -> consumer: "un item por llamada"
