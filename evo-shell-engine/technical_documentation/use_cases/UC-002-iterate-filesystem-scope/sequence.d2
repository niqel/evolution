direction: down

consumer: "consumidor externo" {
  shape: rectangle
}

scope: "&FilesystemScope" {
  shape: rectangle
}

iter_use_case: "Iter(&FilesystemScope)" {
  shape: rectangle
}

iterator_agent: "iterator::iter" {
  shape: rectangle
}

iteration_resolver: "filesystem_iteration::resolve" {
  shape: rectangle
}

read_directory_contract: "ReadDirectory" {
  shape: rectangle
}

read_directory_provider: "read_directory::provide" {
  shape: rectangle
}

std_read_dir: "std::fs::read_dir" {
  shape: rectangle
}

iteration: "FilesystemIteration\n\nread_dir state\nnext_index = 0" {
  shape: rectangle
}

advance_use_case: "Advance(&mut FilesystemIteration)" {
  shape: rectangle
}

advancer_agent: "iteration_advancer::advance" {
  shape: rectangle
}

entry_resolver: "filesystem_entry::resolve" {
  shape: rectangle
}

next_contract: "NextDirectoryEntry" {
  shape: rectangle
}

next_provider: "next_directory_entry::provide" {
  shape: rectangle
}

read_dir_next: "ReadDir::next" {
  shape: rectangle
}

dir_entry: "DirEntry / fin / error" {
  shape: rectangle
}

entry: "FilesystemEntry\n\nname\npath\nkind\nmodified\nsize" {
  shape: rectangle
}

item: "FilesystemIterationItem\n\nindex\nentry" {
  shape: rectangle
}

stage_1: "ETAPA 1 — iniciar" {
  shape: rectangle
  style.fill: "#edf4ff"
}

stage_2: "ETAPA 2 — consumir" {
  shape: rectangle
  style.fill: "#eefaf1"
}

consumer -> stage_1: "inicia iteración"
stage_1 -> iter_use_case: "Iter(&FilesystemScope)"
scope -> iter_use_case: "scope válido prestado"
iter_use_case -> iterator_agent: "use case público"
iterator_agent -> iteration_resolver: "coordina"
iteration_resolver -> read_directory_contract: "consume"
read_directory_contract -> read_directory_provider: "implementado por"
read_directory_provider -> std_read_dir: "std::fs::read_dir"
std_read_dir -> iteration_resolver: "ReadDir / error"
iteration_resolver -> iteration: "FilesystemIteration / IterError"
iteration -> consumer: "devuelve iteración lazy"

consumer -> stage_2: "consume incrementalmente"
stage_2 -> advance_use_case: "Advance(&mut FilesystemIteration)"
advance_use_case -> advancer_agent: "use case público"
advancer_agent -> entry_resolver: "coordina"
entry_resolver -> next_contract: "consume"
next_contract -> next_provider: "implementado por"
next_provider -> iteration: "&mut FilesystemIteration"
next_provider -> read_dir_next: "ReadDir::next"
read_dir_next -> dir_entry: "DirEntry / fin / error"
dir_entry -> entry_resolver: "vuelve al resolver"
entry_resolver -> entry: "resuelve entry + metadata"
iteration -> advancer_agent: "lee next_index"
entry -> advancer_agent: "entry"
advancer_agent -> item: "package index + entry"
advancer_agent -> iteration: "incrementa next_index"
item -> consumer: "un FilesystemIterationItem como máximo"

repeat: "La etapa 2 puede repetirse hasta None\nsin acumular resultados" {
  shape: rectangle
  style.fill: "#fff7e6"
}

consumer -> repeat: "solicita siguiente"
repeat -> advance_use_case: "&mut FilesystemIteration"

error_flow: "Error operativo\nIterError\nscope sin cambios\nno se omite silenciosamente" {
  shape: rectangle
  style.fill: "#fff0f0"
}

read_directory_provider -> error_flow: "error al abrir"
next_provider -> error_flow: "error al avanzar"
entry_resolver -> error_flow: "error al materializar entry o metadata"
