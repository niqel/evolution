direction: right

usuario: "Usuario" {
  shape: person
}

evo_shell_engine: "Evo Shell Engine" {
  shape: rectangle

  iterar_scope: "Iterar filesystem scope" {
    shape: oval
  }
}

entrada: "Entrada conceptual\niter\nFilesystemScope válido" {
  shape: rectangle
}

resultado_exitoso: "resultado estructurado lazy\nFilesystemIterationItem\nindex\nFilesystemEntry\nname path kind modified size" {
  shape: rectangle
}

resultado_alternativo: "iter no completado\nscope activo sin cambios" {
  shape: rectangle
}

presentacion: "representación visual\nseparada en Evo Shell" {
  shape: rectangle
}

usuario -> evo_shell_engine.iterar_scope: "ejecuta iter"
entrada -> evo_shell_engine.iterar_scope: "scope activo"
evo_shell_engine.iterar_scope -> resultado_exitoso: "resultado exitoso"
evo_shell_engine.iterar_scope -> resultado_alternativo: "resultado alternativo"
resultado_exitoso -> presentacion: "puede mostrarse"
