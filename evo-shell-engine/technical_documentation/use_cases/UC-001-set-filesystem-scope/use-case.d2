direction: right

usuario: "Usuario" {
  shape: person
}

evo_shell_engine: "Evo Shell Engine" {
  shape: rectangle

  establecer_scope: "Establecer filesystem scope" {
    shape: oval
  }
}

entrada: "`scope fs <path>`" {
  shape: rectangle
}

resultado_exitoso: "scope activo" {
  shape: rectangle
}

resultado_alternativo: "scope no establecido" {
  shape: rectangle
}

usuario -> evo_shell_engine.establecer_scope: solicita
entrada -> evo_shell_engine.establecer_scope: entrada conceptual
evo_shell_engine.establecer_scope -> resultado_exitoso: resultado exitoso
evo_shell_engine.establecer_scope -> resultado_alternativo: resultado alternativo
