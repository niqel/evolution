direction: down

structured_projection: "StructuredProjection\nproperties: Vec<SelectProperty>\nrows: Vec<ProjectedRow>" {
  shape: rectangle
}

values: "Values\nitems: Vec<ProjectedValue>" {
  shape: rectangle
}

projected_value: "ProjectedValue\nIndex / Created / Modified / Type / Size / Name" {
  shape: rectangle
}

to_values_error: "ToValuesError\nInvalidPropertyCount\nInconsistentRowWidth" {
  shape: rectangle
  style.fill: "#fff0f0"
}

structured_projection -> projected_value: "produce 0..N"
values -> projected_value: "contiene"
structured_projection -> to_values_error: "si no cumple la cardinalidad"
