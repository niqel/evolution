direction: down

consumer: "consumidor" {
  shape: rectangle
}

use_case: "ToValues(StructuredProjection)" {
  shape: rectangle
}

agent: "values_converter::convert" {
  shape: rectangle
}

resolver: "to_values::resolve" {
  shape: rectangle
}

values: "Values" {
  shape: rectangle
}

error: "ToValuesError" {
  shape: rectangle
  style.fill: "#fff0f0"
}

consumer -> use_case: "invoca"
use_case -> agent: "coordina"
agent -> resolver: "delegación"
resolver -> values: "si existe 1 propiedad"
resolver -> error: "si la cardinalidad falla"
values -> consumer: "retorna éxito"
