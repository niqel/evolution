direction: right

title: "Evo Runtime — Functional Interface Map"

runtime: "Evo Runtime [crate: evo-runtime]" {
  style.fill: "#f8fafc"
  style.stroke: "#334155"
  style.stroke-width: 2

  interface: "Provided Functional Interface (Use Case Definitions)" {
    style.fill: "#f0fdf4"
    style.stroke: "#15803d"
    style.stroke-width: 2

    start: "start\n[USE CASE]\n[function pointer]" {
      style.fill: "#dcfce7"
      style.stroke: "#166534"
    }

    determine_implementation: "determine_implementation\n[USE CASE]\n[function pointer]" {
      style.fill: "#dcfce7"
      style.stroke: "#166534"
    }

    make_available: "make_available\n[USE CASE]\n[function pointer]" {
      style.fill: "#dcfce7"
      style.stroke: "#166534"
    }

    invoke: "invoke\n[USE CASE]\n[function pointer]" {
      style.fill: "#dcfce7"
      style.stroke: "#166534"
    }

    transport: "transport\n[USE CASE]\n[function pointer]" {
      style.fill: "#dcfce7"
      style.stroke: "#166534"
    }

    determine_engine: "determine_engine\n[USE CASE]\n[function pointer]" {
      style.fill: "#dcfce7"
      style.stroke: "#166534"
    }

    propagate: "propagate\n[USE CASE]\n[function pointer]" {
      style.fill: "#dcfce7"
      style.stroke: "#166534"
    }

    maintain_context: "maintain_context\n[USE CASE]\n[function pointer]" {
      style.fill: "#dcfce7"
      style.stroke: "#166534"
    }

    finalize: "finalize\n[USE CASE]\n[function pointer]" {
      style.fill: "#dcfce7"
      style.stroke: "#166534"
    }
  }
}
