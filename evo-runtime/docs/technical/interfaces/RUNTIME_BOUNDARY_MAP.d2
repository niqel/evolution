direction: right

title: "Evo Runtime Model A — Boundary & Module Map"

host: "Host\n(Caller externo)" {
  style.fill: "#f8fafc"
  style.stroke: "#475569"
  style.stroke-width: 2
}

runtime: "Evo Runtime [crate: evo-runtime]" {
  style.fill: "#eef2ff"
  style.stroke: "#4338ca"
  style.stroke-width: 2

  start_uc: "definitions/use_cases/start\n<<Use Case>>\nStart\nfn(run_request::Request)" {
    style.fill: "#c7d2fe"
    style.stroke: "#3730a3"
    style.stroke-width: 2
  }

  starter_agent: "agents/starter\n<<Agent>>\nstart(run_request::Request)\nSTART: Start = start" {
    style.fill: "#e0e7ff"
    style.stroke: "#4338ca"
    style.stroke-width: 2
  }

  run_req: "definitions/requesters/run_request\n<<Requester>>\nRequest\nfn()" {
    style.fill: "#fed7aa"
    style.stroke: "#c2410c"
    style.stroke-width: 2
  }

  start_uc -> starter_agent: "implemented by" {
    style.stroke-dash: 4
  }

  starter_agent -> run_req: "invokes"
}

app: "Evo Application\n<<External Implementer>>\nimplementa Request" {
  style.fill: "#f0fdf4"
  style.stroke: "#15803d"
  style.stroke-width: 2
}

# Interactions
host -> runtime.starter_agent: "START(run)"
app -> runtime.run_req: "implements" {
  style.stroke-dash: 4
}
runtime.starter_agent -> host: "return ()" {
  style.stroke-dash: 4
}
