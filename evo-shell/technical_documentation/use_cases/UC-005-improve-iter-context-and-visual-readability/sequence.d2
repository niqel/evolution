direction: down

main_loop: "main/shell loop" {
  shape: rectangle
}

execution_result: "ExecutionResult::FilesystemIteration(iteration)" {
  shape: rectangle
}

presenter: "iteration_presenter::present(iteration)" {
  shape: rectangle
}

iteration_path: "iteration.path()\n\nmisma fuente para Path superior e inferior" {
  shape: rectangle
}

blank_start: "render blank line" {
  shape: rectangle
}

top_path: "render top Path\nPath: <full path>" {
  shape: rectangle
}

blank_before_table: "render blank line" {
  shape: rectangle
}

header: "render table header\n#   Modified   Type   Size   Name" {
  shape: rectangle
}

advance: "Advance(&mut FilesystemIteration)" {
  shape: rectangle
}

item: "FilesystemIterationItem\nindex\nentry" {
  shape: rectangle
}

row: "render row\nType + Name share directory style when kind=Directory" {
  shape: rectangle
}

counters: "update local counters\nfiles\ndirectories" {
  shape: rectangle
}

none: "Advance -> None" {
  shape: rectangle
}

blank_before_summary: "render blank line" {
  shape: rectangle
}

summary: "render summary\nN directories\nN files" {
  shape: rectangle
}

blank_after_summary: "render blank line" {
  shape: rectangle
}

bottom_path: "render bottom Path\nPath: <same full path>" {
  shape: rectangle
}

blank_end: "render blank line" {
  shape: rectangle
}

prompt: "render next prompt\nscope-fs …/target >\nsegments styled separately" {
  shape: rectangle
}

main_loop -> execution_result: "recibe resultado"
execution_result -> presenter: "delega presentación de iter"
presenter -> iteration_path: "lee contexto de la iteración"
presenter -> blank_start: "1"
blank_start -> top_path: "2"
iteration_path -> top_path: "full path"
top_path -> blank_before_table: "3"
blank_before_table -> header: "4"
header -> advance: "5 loop lazy"
advance -> item: "Some(item)"
item -> row: "render una fila"
row -> counters: "actualiza counts"
counters -> advance: "siguiente item"
advance -> none: "fin"
none -> blank_before_summary: "7"
blank_before_summary -> summary: "8"
summary -> blank_after_summary: "9"
blank_after_summary -> bottom_path: "10"
iteration_path -> bottom_path: "same source"
bottom_path -> blank_end: "11"
blank_end -> main_loop: "12 return"
main_loop -> prompt: "render siguiente prompt"

empty_directory: "Directorio vacío\n\nPath se renderiza antes de Advance\nAdvance -> None\nsummary 0/0\nPath se renderiza otra vez" {
  shape: rectangle
  style.fill: "#fff7e6"
}

iteration_path -> empty_directory: "path existe sin items"
none -> empty_directory: "primer Advance puede ser None"

