direction: down

main_loop: "main/shell loop" {
  shape: rectangle
}

execution_result: "ExecutionResult::FilesystemIteration(iteration)" {
  shape: rectangle
}

presenter: "iteration_presenter::present(iteration)" {
  shape: rectangle
}

iteration_path: "iteration.path()\n\nfuente para footer Path" {
  shape: rectangle
}

blank_start: "render blank line" {
  shape: rectangle
}

header: "render table header\n#   Modified   Type   Size   Name" {
  shape: rectangle
}

advance: "Advance(&mut FilesystemIteration)" {
  shape: rectangle
}

item: "FilesystemIterationItem\nindex\nentry" {
  shape: rectangle
}

row: "render row\nType + Name share directory style when kind=Directory" {
  shape: rectangle
}

counters: "update local counters\nfiles\ndirectories" {
  shape: rectangle
}

none: "Advance -> None" {
  shape: rectangle
}

blank_before_summary: "render blank line" {
  shape: rectangle
}

summary: "render summary\nN directories\nN files" {
  shape: rectangle
}

footer_path: "render footer Path\nPath: <full path>\ninmediatamente después de summary" {
  shape: rectangle
}

blank_end: "render blank line" {
  shape: rectangle
}

prompt: "render next prompt\nscope-fs …/target >\nsegments styled separately" {
  shape: rectangle
}

main_loop -> execution_result: "recibe resultado"
execution_result -> presenter: "delega presentación de iter"
presenter -> blank_start: "1"
blank_start -> header: "2"
header -> advance: "3 loop lazy"
advance -> item: "Some(item)"
item -> row: "render una fila"
row -> counters: "actualiza counts"
counters -> advance: "siguiente item"
advance -> none: "fin"
none -> blank_before_summary: "5"
blank_before_summary -> summary: "6"
summary -> iteration_path: "7 lee contexto"
iteration_path -> footer_path: "full path"
footer_path -> blank_end: "8"
blank_end -> main_loop: "9 return"
main_loop -> prompt: "render siguiente prompt"

empty_directory: "Directorio vacío\n\nblank\nheader\nAdvance -> None\nsummary 0/0\nfooter Path\nblank" {
  shape: rectangle
  style.fill: "#fff7e6"
}

iteration_path -> empty_directory: "path existe sin items"
none -> empty_directory: "primer Advance puede ser None"
