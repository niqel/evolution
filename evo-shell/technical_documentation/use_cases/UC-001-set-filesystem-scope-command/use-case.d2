direction: right

usuario: "Usuario" {
  shape: person
}

evo_shell: "Evo Shell" {
  shape: rectangle

  set_scope_command: "Establecer filesystem scope mediante comando" {
    shape: oval
  }
}

engine: "Evo Shell Engine\ncapacidad consumida" {
  shape: rectangle
}

entrada: "Entrada\nscope-fs \"<path>\"" {
  shape: rectangle
}

resultado_exitoso: "scope activo actualizado" {
  shape: rectangle
}

resultado_alternativo: "scope no establecido\nscope anterior conservado" {
  shape: rectangle
}

shell: "Shell\nowns FilesystemScope actual" {
  shape: rectangle
}

usuario -> evo_shell.set_scope_command: "introduce comando"
entrada -> evo_shell.set_scope_command: "texto"
shell -> evo_shell.set_scope_command: "instancia operativa"
evo_shell.set_scope_command -> engine: "consume SetFilesystemScope"
engine -> evo_shell.set_scope_command: "FilesystemScope / error"
evo_shell.set_scope_command -> resultado_exitoso: "resultado exitoso"
evo_shell.set_scope_command -> resultado_alternativo: "resultado alternativo"
