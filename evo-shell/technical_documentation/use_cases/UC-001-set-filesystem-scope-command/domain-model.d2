direction: right

input: "entrada textual\n\nborrowed" {
  shape: rectangle
}

token_stream: "TokenStream\n\ninput borrowed\ncurrent position\nmutable only to advance cursor" {
  shape: rectangle
}

token: "Token\n\nborrowed view when possible\nToken::Word(&str)\nToken::String(&str)" {
  shape: rectangle
}

command: "Command\n\nenum conceptual\nScopeFs(argument)\npuede prestar argumentos mientras la entrada siga viva" {
  shape: rectangle
}

filesystem_scope: "FilesystemScope\n\nproducido por Evo Shell Engine\nowned by Shell after successful engine call" {
  shape: rectangle
}

shell: "Shell\n\ninstancia operativa\nowns FilesystemScope\nvive mientras la shell está operativa" {
  shape: rectangle
}

initialize_shell: "InitializeShell\n\nshell_initializer::initialize\nshell::resolve\nCurrentDirectory\nSetFilesystemScope" {
  shape: rectangle
}

borrowing_rule: "Regla\n\nborrow mientras el dato pueda depender de su fuente\nown cuando deba sobrevivir independientemente" {
  shape: rectangle
  style.fill: "#edf4ff"
}

input -> token_stream: "borrowed input"
token_stream -> token: "&mut TokenStream -> token::resolve -> Token"
token -> command: "command::resolve"
initialize_shell -> shell: "crea Shell operativa"
command -> filesystem_scope: "execution::resolve -> SetFilesystemScope"
filesystem_scope -> shell: "reemplaza scope activo en éxito"
input -> borrowing_rule: "fuente"
token -> borrowing_rule: "vista prestada"
command -> borrowing_rule: "efímero"
