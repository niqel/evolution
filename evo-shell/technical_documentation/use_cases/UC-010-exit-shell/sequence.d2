  shape: rectangle
}

user -> tokenizer: "exit"
tokenizer -> parser: "tokens"
parser -> command: "Command::Exit"
command -> executor: "execute"
executor -> agent: "delegate"
agent -> result: "Exit"
result -> run_loop: "termina loop"
run_loop -> run: "return Ok(())"
run -> main: "process ends normally"
