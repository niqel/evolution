direction: down

user: "User" {
  shape: person
}

tokenizer: "tokenizer::tokenize" {
  shape: rectangle
}

parser: "parser::parse" {
  shape: rectangle
}

command: "Command::Exit" {
  shape: rectangle
}

executor: "executor::execute" {
  shape: rectangle
}

agent: "exiter::exit()" {
  shape: rectangle
}

result: "ExecutionResult::Exit" {
  shape: rectangle
}

run_loop: "run_loop\n\nreturn Ok(())" {
  shape: rectangle
}

run: "run\n\nfin normal" {
  shape: rectangle
}

