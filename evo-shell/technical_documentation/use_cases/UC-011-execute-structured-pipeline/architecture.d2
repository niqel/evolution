pipeline -> execute_pipeline: "structured input"
execute_pipeline -> pipeline_executor: "orquesta"
pipeline_executor -> shell_context: "reads active scope for Iter"
pipeline_executor -> engine: "delegates semantics"
engine -> typed_result: "produces typed state"
pipeline_executor -> typed_result: "returns"
pipeline_executor -> no_resolver: "not required"
pipeline_executor -> no_provider: "not required"
