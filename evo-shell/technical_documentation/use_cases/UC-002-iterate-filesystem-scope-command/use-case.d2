direction: down

usuario: "Usuario" {
  shape: person
}

system: "Evo Shell" {
  shape: rectangle
}

engine: "Evo Shell Engine" {
  shape: rectangle
  style.fill: "#f2f2f2"
}

input: "Entrada\n\niter" {
  shape: rectangle
}

precondition: "Precondición funcional\n\nfilesystem scope activo" {
  shape: rectangle
  style.fill: "#edf4ff"
}

use_case: "Caso de uso\n\nIterar filesystem scope activo mediante comando" {
  shape: rectangle
}

success: "Resultado exitoso\n\nelementos presentados" {
  shape: rectangle
  style.fill: "#eefaf1"
}

no_scope: "Alternativa\n\nno hay scope activo" {
  shape: rectangle
  style.fill: "#fff7e6"
}

iteration_error: "Alternativa\n\nerror de iteración" {
  shape: rectangle
  style.fill: "#fff0f0"
}

usuario -> input: "introduce"
input -> system: "recibe"
system -> precondition: "requiere"
precondition -> use_case: "permite ejecutar"
system -> use_case: "reconoce iter"
use_case -> engine: "consume Iter(&FilesystemScope)"
engine -> success: "FilesystemIteration / FilesystemEntry"
use_case -> no_scope: "sin scope activo\nno llama engine"
engine -> iteration_error: "error operativo"
success -> usuario: "presenta"
no_scope -> usuario: "presenta error conceptual"
iteration_error -> usuario: "presenta error conceptual"
