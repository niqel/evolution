direction: right

lexical_reused: {
  label: "Lexical Data · reused"
  SourceSpan: { label: "<<struct>> SourceSpan" }
}

ast: {
  label: "AST Data · owner · 31 identities"

  foundational: {
    label: "Foundational · 4"
    Identifier: { label: "<<struct>> Identifier<'source>" }
    QualifiedName: { label: "<<struct>> QualifiedName<'source>" }
    Visibility: { label: "<<enum>> Visibility\n2 variants" }
    TypedBinding: { label: "<<struct>> TypedBinding<'source>" }
  }

  top_level: {
    label: "Top-level · 3"
    Program: { label: "<<struct>> Program<'source>" }
    ImportDeclaration: { label: "<<struct>> ImportDeclaration<'source>" }
    Declaration: { label: "<<enum>> Declaration<'source>\n3 variants" }
  }

  types: {
    label: "Local Type Definitions · 4"
    StructDefinition: { label: "<<struct>> StructDefinition<'source>" }
    FieldDefinition: { label: "<<struct>> FieldDefinition<'source>" }
    EnumDefinition: { label: "<<struct>> EnumDefinition<'source>" }
    EnumVariant: { label: "<<enum>> EnumVariant<'source>\n3 variants" }
  }

  functions: {
    label: "Functions / Body · 6"
    FunctionDefinition: { label: "<<struct>> FunctionDefinition<'source>" }
    Parameter: { label: "<<enum>> Parameter<'source>\n2 variants" }
    FunctionBody: { label: "<<struct>> FunctionBody<'source>" }
    BodyStatement: { label: "<<enum>> BodyStatement<'source>\n2 variants" }
    LetBinding: { label: "<<struct>> LetBinding<'source>" }
    OperationStatement: { label: "<<enum>> OperationStatement<'source>\n2 variants" }
  }

  expressions: {
    label: "Expressions · 10"
    Expression: { label: "<<struct>> Expression<'source>" }
    ExpressionKind: { label: "<<enum>> ExpressionKind<'source>\n10 variants" }
    LiteralKind: { label: "<<enum>> LiteralKind\n4 variants" }
    UnaryOperator: { label: "<<enum>> UnaryOperator\n2 variants" }
    BinaryOperator: { label: "<<enum>> BinaryOperator\n13 variants" }
    FunctionCall: { label: "<<struct>> FunctionCall<'source>" }
    FieldInitializer: { label: "<<struct>> FieldInitializer<'source>" }
    EnumConstruction: { label: "<<enum>> EnumConstruction<'source>\n3 variants" }
    Pipeline: { label: "<<struct>> Pipeline<'source>" }
    PipelineStage: { label: "<<struct>> PipelineStage<'source>" }
  }

  when_data: {
    label: "When · 4"
    WhenExpression: { label: "<<struct>> WhenExpression<'source>" }
    WhenCorrespondence: { label: "<<struct>> WhenCorrespondence<'source>" }
    WhenPattern: { label: "<<enum>> WhenPattern<'source>\n3 variants" }
    PatternField: { label: "<<struct>> PatternField<'source>" }
  }
}

