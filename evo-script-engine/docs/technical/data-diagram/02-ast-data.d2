notes: {
  label: "AST Data Boundaries"
  count: "Exactly 31 AST identities; SourceSpan is reused from Lexical Data"
  tree: "AST physical representation is a typed nested owned tree"
  no_fake_nodes: "Literal, Unary, Binary, FieldAccess and StructConstruction remain ExpressionKind variants"
  no_return: "return is parser-consumed syntax; FunctionBody.result owns the final Expression"
  no_this: "this is parser-only pipeline syntax and does not survive as an AST identity"
  semantic: "No TypeId, FunctionId, resolved Signature, slots, Provider bindings or bytecode"
}
