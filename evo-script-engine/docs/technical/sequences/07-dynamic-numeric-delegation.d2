dynamic_numeric_delegation: {
  shape: sequence_diagram

  instruction_executor: "collaborators/instruction_executor"
  observe_runtime_value: "tools/observe_runtime_value"
  evo_dynamic_numeric: "evo-values::dynamic_numeric"

  operand_observation: {
    instruction_executor -> observe_runtime_value: "OBSERVE_RUNTIME_VALUE(left_dyn, compiled_program, backing_store)"
    observe_runtime_value -> instruction_executor: "&DynamicValue · borrowed view via as_borrowed()"
    instruction_executor -> observe_runtime_value: "OBSERVE_RUNTIME_VALUE(right_dyn, compiled_program, backing_store)"
    observe_runtime_value -> instruction_executor: "&DynamicValue · borrowed view via as_borrowed()"
  }

  binary_arithmetic: {
    instruction_executor -> evo_dynamic_numeric: "DYNAMIC_ADD(&left, &right)"
    evo_dynamic_numeric -> instruction_executor: "Result<OwnedDynamicValue, DynamicNumericFailure>"
  }

  unary_arithmetic: {
    instruction_executor -> evo_dynamic_numeric: "DYNAMIC_NEGATE(&operand)"
    evo_dynamic_numeric -> instruction_executor: "Result<OwnedDynamicValue, DynamicNumericFailure>"
  }

  remainder_valid_integer: {
    instruction_executor -> evo_dynamic_numeric: "DYNAMIC_REMAINDER(&left, &right) · Integer + Integer"
    evo_dynamic_numeric -> instruction_executor: "Result<OwnedDynamicValue, DynamicNumericFailure>"
  }

  remainder_language_guard: {
    instruction_executor -> instruction_executor: "DYNAMIC_REMAINDER guard · Float family detected → EvaluationFailure::DynamicNumericType (NO CALL TO DYNAMIC_REMAINDER)"
  }

  instruction_executor."Dynamic Integer operands are borrowed zero-copy (as_borrowed()). Owned integer results are moved into DynamicIntegerBacking without BigInt marshaling. Floats remain inline."
  evo_dynamic_numeric."Cross-family operations return DynamicNumericFailure::DifferentFamily (→ EvaluationFailure::DynamicNumericType). Integer division by zero returns DivisionByZero; Float division by ±0.0 produces IEEE 754 results."
}
